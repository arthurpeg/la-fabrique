# Copier en .env (non versionné) et ajuster.
# Contraintes : hors du dépôt, hors de tout dossier synchronisé par OneDrive,
# sans espace ni accent dans le chemin.
RSL_DATA_DIR=D:\quant-data\Cotations

# Moissonnage du corpus (D20), FACULTATIF.
# OpenAlex repond sans elle (pool commun, plus lent) ; Unpaywall l'EXIGE et
# est saute sans elle — ce qui reduit le rendement en PDF. La renseigner est
# un geste deliberement laisse a l'utilisateur : c'est une donnee personnelle
# envoyee a un tiers.
HARVEST_MAILTO=
