# Copier en .env (non versionné) et ajuster.
# Contraintes : hors du dépôt, hors de tout dossier synchronisé par OneDrive,
# sans espace ni accent dans le chemin.
RSL_DATA_DIR=D:\quant-data\Cotations

# Moissonnage du corpus (D20), FACULTATIF.
# OpenAlex repond sans elle (pool commun, plus lent) ; Unpaywall l'EXIGE et
# est saute sans elle — ce qui reduit le rendement en PDF. La renseigner est
# un geste deliberement laisse a l'utilisateur : c'est une donnee personnelle
# envoyee a un tiers.
HARVEST_MAILTO=

# Banc d'essai de l'extracteur (corpus/bench_extractor.py), FACULTATIF.
# Necessaire UNIQUEMENT pour le backend `gemini` : sans elle, le banc refuse
# de demarrer plutot que d'essayer et d'echouer a mi-parcours.
#
# La cle se recupere sur Google AI Studio (aistudio.google.com) > Get API key.
# SANS guillemets et SANS espace autour du `=` : la valeur est lue telle quelle.
# `GOOGLE_API_KEY` est accepte en repli si elle est deja presente.
#
# Elle voyage dans un EN-TETE HTTP, jamais dans l'URL — une cle en parametre de
# requete se retrouve dans les journaux de serveur et les traces d'erreur.
GEMINI_API_KEY=

# La base vectorielle (vectordb/). Fournie par Supabase.
DATABASE_URL=
