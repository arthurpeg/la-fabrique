# Données brutes — elles vivent sous RSL_DATA_DIR, hors du dépôt.
# Ce qui est versionné : le catalogue, les fiches, le registre. Des résultats,
# pas des données.
corpus/pdf/*
!corpus/pdf/.gitkeep
data/
*.parquet
*.feather
*.h5
*.db

# Environnement
.env
.venv/
venv/

# Caches
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Système
.DS_Store
Thumbs.db

# Obsidian — l'état de la fenêtre change à chaque ouverture et n'intéresse
# personne. Le reste de .obsidian/ (dont graph.json) est versionné exprès :
# c'est la configuration partagée du coffre. Voir CLAUDE.md § Wiki.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Les consignes d'extraction sont fabriquées par corpus/extract_fiche.py à
# partir du schéma et du texte (D18) : dérivées, volumineuses, reproductibles.
corpus/consignes/
